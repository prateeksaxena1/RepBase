{
  "expo": {
    "name": "RepBase",
    "slug": "repbase",
    "version": "1.0.0",
    "scheme": "repbase",
    "orientation": "portrait",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}