{
  "expo": {
    "name": "RepBase",
    "slug": "repbase",
    "version": "1.0.0",
    "scheme": "repbase",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#0D0D0D",
      "resizeMode": "contain"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RepBase needs camera access to scan food barcodes."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
